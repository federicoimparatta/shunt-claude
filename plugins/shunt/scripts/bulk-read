#!/bin/bash
# Delegate file reading to the local bulk-reader worker.
# Usage: bulk-read --question "what does this do?" --paths file1.ts file2.ts
#
# Modified from spotify/portal-ai-plugins plugins/shunt (Apache-2.0).

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

MODE_NAME="bulk-reader"

question=""
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --question) question="$2"; shift 2 ;;
    --paths)    shift; while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do paths+=("$1"); shift; done ;;
    *)          shift ;;
  esac
done

shunt_guard || exit 1

if [ -z "$question" ]; then
  echo "Error: --question is required" >&2
  exit 1
fi

if [ ${#paths[@]} -eq 0 ]; then
  echo "Error: --paths is required" >&2
  exit 1
fi

# A typo'd path would be sent as an empty <file> block and produce a
# confident answer about nothing, so fail loudly instead. Binary files would
# arrive as noise; the Read tool renders images and PDFs natively.
for path in "${paths[@]}"; do
  if [ ! -f "$path" ] || [ ! -r "$path" ]; then
    echo "Error: file not found or unreadable: $path" >&2
    exit 1
  fi
  if shunt_is_binary "$path"; then
    echo "Error: not a text file: $path" >&2
    echo "bulk-read sends text only. Use the Read tool for images and PDFs." >&2
    exit 1
  fi
done

shunt_preflight || exit 1
shunt_tmpfile message_file || exit 1

# Wrap each file in XML tags so the worker sees clear boundaries, and number
# its lines (like cat -n) so the line numbers it cites are exact and can feed
# a targeted Read. Stream straight into the message file: no corpus-sized
# shell variable.
printf 'Each file below is wrapped in a <file path="..."> tag. Every line starts with its line number and a tab; cite those numbers, and leave the prefixes out of any code you quote.\n\n' > "$message_file"
for path in "${paths[@]}"; do
  {
    printf '<file path="%s">\n' "$path"
    LC_ALL=C awk '{ printf "%6d\t%s\n", NR, $0 }' "$path"
    printf '</file>\n\n'
  } >> "$message_file"
done
printf 'Question: %s\n' "$question" >> "$message_file"

shunt_invoke "$MODE_NAME" "$message_file" || exit 1

# Token usage to stderr
char_count=$(wc -c < "$message_file" | tr -d ' ')
echo "[shunt: ~$((char_count / 4)) input tokens | delegated to $MODE_NAME ($SHUNT_WORKER_MODEL)]" >&2
