#!/bin/bash
# Delegate boilerplate generation to the local code-writer worker.
# Usage: code-write --spec "write tests for UserService" --reference ref.test.ts --target out.test.ts
#
# Modified from spotify/portal-ai-plugins plugins/shunt (Apache-2.0).

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

MODE_NAME="code-writer"

spec=""
reference=""
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)      spec="$2"; shift 2 ;;
    --reference) reference="$2"; shift 2 ;;
    --target)    target="$2"; shift 2 ;;
    *)           shift ;;
  esac
done

shunt_guard || exit 1

if [ -z "$spec" ]; then
  echo "Error: --spec is required" >&2
  exit 1
fi

# A bare spec would generate context-free code that matches nothing in the
# project, so fail loudly rather than write plausible-looking output.
if [ -z "$reference" ]; then
  echo "Error: --reference is required. Pass a file whose patterns the output should match." >&2
  echo "For a follow-up, reference the file the previous call just generated." >&2
  exit 1
fi
if [ ! -f "$reference" ] || [ ! -r "$reference" ]; then
  echo "Error: reference file not found or unreadable: $reference" >&2
  exit 1
fi
if shunt_is_binary "$reference"; then
  echo "Error: reference is not a text file: $reference" >&2
  exit 1
fi

shunt_preflight || exit 1
shunt_tmpfile message_file || exit 1
shunt_tmpfile answer_file || exit 1

printf 'Spec: %s\n\nReference:\n' "$spec" > "$message_file"
cat "$reference" >> "$message_file"

shunt_invoke "$MODE_NAME" "$message_file" > "$answer_file" || exit 1

# Strip markdown fences (the model sometimes wraps despite instructions)
clean=$(sed '/^```/d' "$answer_file")

# Write to target or stdout
if [ -n "$target" ]; then
  printf '%s\n' "$clean" > "$target" || exit 1
  echo "Wrote $(wc -l < "$target" | tr -d ' ') lines to $target" >&2
else
  printf '%s\n' "$clean"
fi

# Token usage to stderr
echo "[shunt: delegated to $MODE_NAME ($SHUNT_WORKER_MODEL)]" >&2
